{
  "name": "flagbase",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "dashboard:dev": "pnpm --filter @flagbase/dashboard dev"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=18"
  }
}

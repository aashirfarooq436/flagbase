{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],

    // No ambient type packages: contracts is pure types + Zod schemas, with no Node or DOM
    // usage. It must stay frontend-safe — it never imports core, so DTOs can't drift and the
    // client can share these schemas without pulling the domain in.
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}

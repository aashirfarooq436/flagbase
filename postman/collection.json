    {
      "name": "Auth",
      "description": "Registration and login. Session lives in the `flagbase_session` cookie.",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh unique email each run (email is unique).",
                  "pm.collectionVariables.set('email', 'aashir+' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Returns the user, never a passwordHash', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('id');",
                  "  pm.expect(b.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(b).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"name\": \"{{name}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-up"
              ]
            },
            "description": "Registers a new user and starts their session. 409 if the email is taken; 400 with field errors on invalid input. A unique email is generated per run."
          }
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the signed-in user', () => pm.expect(pm.response.json()).to.have.property('id'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-in"
              ]
            },
            "description": "Signs in with the email from the last Sign Up. 401 with one generic message for both unknown-email and wrong-password (no account enumeration)."
          }
        }
      ]

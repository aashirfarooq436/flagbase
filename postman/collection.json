          }
        },
        {
          "name": "Remove Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responds (owner target ⇒ policy error is expected)', () => pm.expect(pm.response.code).to.be.oneOf([204, 400, 403, 404, 409]));"
                ]
              }
            }
